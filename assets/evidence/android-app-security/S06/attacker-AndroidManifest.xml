<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aas.stealer">
    <uses-permission android:name="com.insecureshop.permission.READ"/>
    <queries>
        <package android:name="com.insecureshop"/>
        <provider android:authorities="com.insecureshop.provider"/>
    </queries>
    <application android:label="ProviderStealer" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
